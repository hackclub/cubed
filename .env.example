# Used ONLY by docker-compose.yaml (local Postgres). Copy to .env — never commit it.
#   cp .env.example .env
#
# Password for the local Postgres user "cubed". Use something other than the
# default if this machine is ever on a network you don't control.
#
# Postgres only reads this when the data volume is FIRST created. To change it
# on an existing local database, either:
#   docker compose exec postgres psql -U cubed -c "ALTER USER cubed PASSWORD 'new-password'"
# or wipe the local data and start fresh (deletes ALL local data):
#   docker compose down -v
# Then put the same password in backend/.env's DATABASE_URL:
#   DATABASE_URL=postgres://cubed:<password>@localhost:5432/cubed
POSTGRES_PASSWORD=cubed
