---
// Where a manually banned account lands (backend/src/routes/auth.ts sends them
// here at login; middleware.ts and the API client send them here when a ban
// lands mid-session). Public on purpose: the ban already removed their access,
// and this page reveals nothing about anyone. The reason a ban was made is kept
// internal (Airtable's ban_reason) and never shown.
import DashboardLayout from "../layouts/DashboardLayout.astro";
---

<DashboardLayout title="Account suspended">
  <div class="flex min-h-screen items-center justify-center bg-[#cfe0d5] p-4">
    <div class="w-full max-w-md rounded-none border-[8px] border-[#5c4429] bg-white p-6 text-center sm:border-[10px] sm:p-8">
      <h1 class="font-anta text-3xl font-bold text-[#2e4a3d] sm:text-4xl">Account suspended</h1>
      <p class="mt-4 text-black/70">Your Cubed account has been suspended by the Cubed team.</p>
      <p class="mt-3 text-black/70">Think this is a mistake? Message the Cubed team on Slack.</p>

      <div class="mt-6 border-t-2 border-[#5c4429]/20 pt-4">
        <a href="/" class="text-sm font-bold text-black/50 underline hover:text-black">Back home</a>
      </div>
    </div>
  </div>
</DashboardLayout>
