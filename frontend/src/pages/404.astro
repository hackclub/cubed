---
// Errir screens change depdning on if your in the dashboard, docs, or other page
import "../styles/app.css";
import "../styles/global.css";
import bgImg from "../Images/dashboard/bg.png";

const pathname = Astro.url.pathname;
const section =
  Astro.url.searchParams.get("section") === "docs"
    ? "docs"
    : pathname.startsWith("/dashboard") || pathname.startsWith("/onboarding") || pathname.startsWith("/admin")
      ? "dashboard"
      : "home";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg" href="/logo.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Anta&family=Space+Mono:wght@400;700&display=swap"
			rel="stylesheet"
		/>
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex, nofollow" />
		<title>Page not found - Cubed</title>
	</head>
	{
		section === "docs" ? (
			<body class="min-h-screen bg-[#f2ecdd] text-black" style="font-family: system-ui, -apple-system, sans-serif;">
				<div class="flex min-h-screen flex-col items-center justify-center px-4 py-10 text-center">
					<div class="w-full max-w-md rounded-lg border border-black/10 bg-white p-8 shadow-sm sm:p-10">
						<p class="text-6xl font-bold sm:text-7xl">404</p>
						<h1 class="mt-4 text-xl font-bold sm:text-2xl">This page doesn't exist</h1>
						<p class="mt-2 text-sm text-black/60 sm:text-base">
							That doc might have moved or been renamed. Try the docs index instead.
						</p>
						<div class="mt-8 flex flex-wrap items-center justify-center gap-3 text-sm font-bold">
							<a href="/docs" class="rounded-md border border-black/10 bg-[#f2ecdd] px-4 py-2 hover:bg-black/5">
								Docs home
							</a>
							<a href="/dashboard" class="rounded-md bg-blue-600 px-4 py-2 text-white hover:bg-blue-700">
								Dashboard
							</a>
							<a href="/" class="rounded-md border border-black/10 bg-[#f2ecdd] px-4 py-2 hover:bg-black/5">
								Home
							</a>
						</div>
					</div>
				</div>
			</body>
		) : section === "dashboard" ? (
			<body class="app-shell relative min-h-screen">
				<div class="fixed inset-0 -z-10 overflow-hidden bg-[#c7e9ff]">
					<img src={bgImg.src} alt="" class="h-full w-full scale-110 object-cover blur-md" />
				</div>

				<div class="flex min-h-screen flex-col items-center justify-center px-4 py-10 text-center">
					<div class="w-full max-w-md rounded-none border-[6px] border-[#5c4429] bg-[#f2ecdd]/95 p-8 backdrop-blur-sm sm:p-10">
						<p class="text-6xl text-[#2e4a3d] sm:text-7xl" style="font-family: var(--font-anta);">
							404
						</p>
						<h1 class="mt-4 text-xl font-bold text-[#2e4a3d] sm:text-2xl">This page doesn't exist</h1>
						<p class="mt-2 text-sm text-black/60 sm:text-base">
							It may have moved, or the link might just be wrong. Let's get you back somewhere useful.
						</p>
						<div class="mt-8 flex flex-wrap items-center justify-center gap-3 text-xs font-bold uppercase tracking-wide sm:text-sm">
							<a href="/" class="rounded-none border-2 border-[#5c4429] bg-white px-4 py-2 hover:bg-app-mint/30">
								Home
							</a>
							<a href="/dashboard" class="rounded-none border-2 border-[#5c4429] bg-app-mint px-4 py-2 hover:bg-app-mint/70">
								Dashboard
							</a>
							<a href="/docs" class="rounded-none border-2 border-[#5c4429] bg-white px-4 py-2 hover:bg-app-mint/30">
								Docs
							</a>
						</div>
					</div>
				</div>
			</body>
		) : (
			<body class="min-h-screen bg-[var(--c-bg-hero)] text-[var(--c-text)]">
				<div class="flex min-h-screen flex-col items-center justify-center px-4 py-10 text-center">
					<p class="font-anta text-[16vw] leading-none sm:text-[10rem]">404</p>
					<h1 class="font-anta mt-4 text-xl tracking-tight sm:text-2xl">This page doesn't exist</h1>
					<p class="mt-3 max-w-md text-sm text-[var(--c-text-2)] sm:text-base">
						It may have moved, or the link might just be wrong. Let's get you back to shipping science projects.
					</p>
					<div class="mt-10 flex flex-wrap items-center justify-center gap-4 text-base sm:text-lg">
						<a href="/" class="bg-white text-black outline-4 outline-black/15 px-6 py-3 font-light hover:scale-105 transition-all duration-200">
							Home
						</a>
						<a href="/dashboard" class="bg-white text-black outline-4 outline-black/85 px-6 py-3 font-light hover:scale-105 transition-all duration-200">
							Dashboard →
						</a>
						<a href="/docs" class="bg-white text-black outline-4 outline-black/15 px-6 py-3 font-light hover:scale-105 transition-all duration-200">
							Docs
						</a>
					</div>
				</div>
			</body>
		)
	}
</html>
