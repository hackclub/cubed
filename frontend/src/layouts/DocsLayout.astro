---
// Auth-agnostic — renders identically whether Astro.locals.user is set or
// not; the "← Back to..." button inside DocsNav.astro is the only thing
// that changes. Visual language is a deliberate exception to the rest of
// the app's thick-border/Anta system — clean system-sans, thin gray
// borders. Left-aligned (no `mx-auto`) so the nav sits at the actual left
// edge on a wide screen. Three-column grid collapses to a `<details>`
// dropdown nav below `lg`, with the TOC hidden entirely.
import "../styles/app.css";
import { ClientRouter } from "astro:transitions";
import SeoMeta from "../components/SeoMeta.astro";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Cubed docs — how to get started, submit a project, and use the shop." } = Astro.props;
---

<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg" href="/logo.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <ClientRouter />
    <title>{title} - Cubed Docs</title>
    <SeoMeta title={`${title} - Cubed Docs`} {description} />
  </head>
  <body class="min-h-screen bg-[#f2ecdd] text-black" style="font-family: system-ui, -apple-system, sans-serif;">
    <div class="flex flex-col gap-8 px-4 py-8 sm:px-6 lg:flex-row lg:gap-10">
      <!-- One render site, not a mobile + desktop copy — DocsNav.astro
           itself handles both breakpoints. -->
      <aside class="lg:w-64 lg:shrink-0">
        <div class="lg:sticky lg:top-8">
          <slot name="nav" />
        </div>
      </aside>

      <main class="min-w-0 flex-1">
        <article
          class="max-w-4xl leading-relaxed [&_a]:text-blue-600 [&_a]:underline [&_code]:rounded [&_code]:bg-black/5 [&_code]:px-1.5 [&_code]:py-0.5 [&_code]:text-sm [&_h1]:mb-4 [&_h1]:mt-2 [&_h1]:text-3xl [&_h1]:font-bold [&_h2]:mb-3 [&_h2]:mt-8 [&_h2]:scroll-mt-8 [&_h2]:text-xl [&_h2]:font-bold [&_h3]:mb-2 [&_h3]:mt-6 [&_h3]:scroll-mt-8 [&_h3]:text-lg [&_h3]:font-bold [&_li]:mb-1 [&_ol]:mb-4 [&_ol]:list-decimal [&_ol]:pl-6 [&_p]:mb-4 [&_ul]:mb-4 [&_ul]:list-disc [&_ul]:pl-6 [&_strong]:font-bold [&_hr]:my-8 [&_hr]:border-black/10 [&_blockquote]:mb-4 [&_blockquote]:border-l-4 [&_blockquote]:border-black/20 [&_blockquote]:pl-4 [&_blockquote]:text-black/70 [&_table]:mb-4 [&_table]:block [&_table]:overflow-x-auto [&_th]:border [&_th]:border-black/20 [&_th]:bg-black/5 [&_th]:px-3 [&_th]:py-2 [&_th]:text-left [&_td]:border [&_td]:border-black/20 [&_td]:px-3 [&_td]:py-2 [&_td]:align-top [&_pre]:mb-4 [&_pre]:overflow-x-auto [&_pre]:rounded [&_pre]:bg-black/5 [&_pre]:p-4 [&_pre_code]:bg-transparent [&_pre_code]:p-0 [&_img]:max-w-full"
        >
          <slot />
        </article>
      </main>

      <!-- Hidden below xl:, no dropdown fallback. -->
      <aside class="hidden w-56 shrink-0 xl:block">
        <div class="sticky top-8">
          <slot name="toc" />
        </div>
      </aside>
    </div>
  </body>
</html>
