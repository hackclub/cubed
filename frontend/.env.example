# Copy this to .env and fill in real values:
#   cp .env.example .env
# Public, non-secret config only — any PUBLIC_-prefixed var here gets
# baked verbatim into the shipped JS bundle, readable by anyone who opens
# dev tools. Never put a real secret in here or in frontend/.env — every
# real secret (Airtable PAT, Hack Club Auth client secret, Slack/CDN
# tokens) lives only in backend/.env, which this file has no access to.

# Server-side (Astro SSR) calls to the backend — not shipped to the
# browser, so this one CAN safely be an internal-only address, e.g. a
# docker-compose service name in prod (http://backend:8787/api) instead
# of a publicly reachable URL.
BACKEND_URL=http://localhost:8787/api
# (Read from the container's environment at request time, so it can differ per deploy
# without rebuilding the image.)

# Client-side (browser) calls to the backend — must be the backend's real,
# publicly reachable URL (this exact string ships inside the JS bundle),
# and must match one of the backend's own FRONTEND_ORIGINS-adjacent CORS
# config for requests to succeed.
# A relative value such as /api is fine when one domain serves both (then the session cookie,
# which is host-only, is shared too). It is baked in at BUILD time: pass it as a Docker build arg.
PUBLIC_BACKEND_URL=http://localhost:8787/api
