# Copy this to .env and fill in real values:
#   cp .env.example .env
# .env is gitignored — this file (.env.example) is committed and must
# never contain a real secret, credential, or internal hostname/IP. Every
# value below is either a placeholder, or a dev-only default that matches
# docker-compose.yaml's own hardcoded local Postgres credentials (not a
# real password, and not reachable outside your machine's Docker network).

# --- Database ---
# Matches docker-compose.yaml's postgres service (user/pass/db all "cubed").
# Only change this if you're pointing at a different Postgres instance.
DATABASE_URL=postgres://cubed:cubed@localhost:5432/cubed

# --- Server ---
PORT=8787
# MUST be "development" (locally) or "production" (deployed); anything else, or unset, refuses
# to boot. In production every URL below (FRONTEND_URL, FRONTEND_ORIGINS, the OAuth redirect)
# must be https and COOKIE_SIGNING_SECRET at least 32 characters.
NODE_ENV=development

# Who may tell us a visitor's real IP (the X-Real-IP header): comma-separated IPs/CIDRs of your
# ingress and of the frontend server. Anyone else's header is ignored, so a client can't dodge the
# rate limits by inventing one. REQUIRED outside development (set it to `*` only if the backend is
# reachable solely through your ingress/frontend). Development defaults to loopback + private ranges.
# TRUSTED_PROXIES=10.0.0.0/8

# Secret that signs the short-lived signup cookie. REQUIRED outside development; use a long random
# string (e.g. `openssl rand -hex 32`), different from every other secret.
# COOKIE_SIGNING_SECRET=

# Comma-separated allowlist of origins allowed to call this API — never
# '*'. Must exactly match the frontend's real origin(s), including scheme
# and port, with no trailing slash.
FRONTEND_ORIGINS=http://localhost:4321
# Used to build the URL the OAuth callback and email-adjacent links
# redirect back to (e.g. ".../dashboard" on a successful login).
FRONTEND_URL=http://localhost:4321

# --- Hack Club Auth (create an app: https://auth.hackclub.com/developer/apps/new) ---
# This whole API is mounted under /api (see src/index.ts), so the redirect
# URI you register with Hack Club Auth must include that prefix and match
# HACKCLUB_AUTH_REDIRECT_URI below EXACTLY (scheme/host/port/path) or the
# OAuth exchange will fail.
HACKCLUB_AUTH_CLIENT_ID=
HACKCLUB_AUTH_CLIENT_SECRET=
HACKCLUB_AUTH_REDIRECT_URI=http://localhost:8787/api/auth/callback

# --- Airtable ---
# Personal Access Token: https://airtable.com/create/tokens — needs
# data.records:read and data.records:write scopes,
# with access granted to the one base below. Treat it like a password.
AIRTABLE_PAT=
# The base ID (starts with "app...") — visible in the base's URL, or via
# https://airtable.com/api for that base.
AIRTABLE_BASE_ID=
# Table IDs (start with "tbl...") — open the table, check the URL, or use
# the base's API docs page. One table per purpose:
AIRTABLE_SUBMISSIONS_TABLE_ID=
AIRTABLE_SHOP_ITEMS_TABLE_ID=
AIRTABLE_FULFILLMENT_TABLE_ID=
# The submissions table's attachment field ID (starts with "fld...") that
# the project screenshot gets uploaded into — find it in that base's API
# docs page under the submissions table's fields.
AIRTABLE_SCREENSHOT_FIELD_ID=
# How often (seconds) the backend polls Airtable for review decisions and
# shop-item changes. A run costs only 1-2 Airtable requests (pending submissions
# are fetched in batches of 50), well under Airtable's ~5 requests/second per
# base limit. After any 429 all syncing pauses for 30 seconds automatically.
AIRTABLE_SYNC_INTERVAL_SECONDS=10
# Optional: the Airtable "Users" table (tbl...). When set, users are mirrored there and
# its `role` column (user | admin | banned) controls admin/ban in the app. Needs these
# columns: id, slack_id, username, Email, hackatime_id, signed_up_at, last_sync_at,
# role, ban_reason, block_reason. Anyone who can edit this table can make anyone an
# admin, so keep its access limited. Leave blank to keep admin/ban database-only.
AIRTABLE_USERS_TABLE_ID=
# How often (seconds) role changes made in that table are picked up.
AIRTABLE_USERS_SYNC_INTERVAL_SECONDS=30

# --- Newsletter audience (optional) ---
# Table id of the "Loops" table. When set, Cubed keeps one row per account there (email plus activity
# timestamps, nothing else) for Hack Club's Loops sync to pick up. Leave blank to turn it off.
AIRTABLE_LOOPS_TABLE_ID=
# lowerCamelCase program slug from the Unified YSWS database. Until it is known the timestamp
# columns have plain names ("Signed Up At"); once set, Cubed writes "Loops - <slug>SignUpAt" etc.
# Rename the Airtable columns at the same moment you set this, or the sync fails with a 422.
LOOPS_PROGRAM_SLUG=
LOOPS_SYNC_INTERVAL_SECONDS=300

# --- Slack (optional — only used to fetch a user's profile photo at login) ---
# A Slack app's bot token (starts with "xoxb-") with the `users:read`
# scope: https://api.slack.com/apps. Leave blank to skip avatars — users
# just get an initial-letter avatar instead, nothing breaks.
SLACK_BOT_TOKEN=

# --- Hack Club CDN (optional — for project showcase photos) ---
# Create a key on https://cdn.hackclub.com's API Keys page (docs:
# https://cdn.hackclub.com/docs/api). Leave blank to disable showcase
# photo uploads (that one route 503s; nothing else is affected).
HACKCLUB_CDN_API_KEY=
